# Server configuration
# Copy to .env only when adding a provider-backed vision analyzer.
# Never commit production credentials.

# Optional Python executable used by the Next.js bridge.
BANNA_PYTHON=python3

# Optional root directory used by the Next.js bridge; defaults to this repository.
# BANNA_PROJECT_ROOT=/absolute/path/to/Banna

# Optional external multimodal provider configuration for Issue #24.
# BANNA_VISION_PROVIDER=
# BANNA_VISION_API_KEY=
# BANNA_VISION_MODEL=
